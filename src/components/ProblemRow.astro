---
import { problemById, url } from '../lib/data';

interface Props {
  id: string;
}
const p = problemById.get(Astro.props.id)!;
const LABEL = { practice: 'Practice', leetcode: 'LeetCode', article: 'Article', video: 'Video' };
const diff = p.kind === 'article' ? 'article' : (p.difficulty ?? '');
---

<div class="problem-row" data-id={p.id} data-diff={diff} data-title={p.title.toLowerCase()}>
  <input type="checkbox" class="solved" aria-label={`Mark ${p.title} solved`} />
  <a class="title" href={url(`/problems/${p.id}/`)}>{p.title}</a>
  <span class="meta">
    <span class="revisit-dot" title="Marked to revisit">↻</span>
    <span class="note-dot" title="Has notes">✎</span>
    {diff && <span class={`chip ${diff}`}>{p.kind === 'article' ? 'read' : diff}</span>}
  </span>
  <span class="links">
    {
      (['practice', 'leetcode', 'article', 'video'] as const).map((k) =>
        p.links[k] ? (
          <a href={p.links[k]} target="_blank" rel="noopener">
            {LABEL[k]}
          </a>
        ) : (
          <span aria-hidden="true" />
        ),
      )
    }
  </span>
</div>
